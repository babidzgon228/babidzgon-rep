# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-your-token

# Ключ Claude API (https://console.anthropic.com) — без него бот работает, но без ИИ
ANTHROPIC_API_KEY=

# Модель Claude (по умолчанию claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# Твой Telegram user id (узнать: @userinfobot). Через запятую, если несколько.
# Если пусто — ботом может пользоваться кто угодно (не рекомендуется: ИИ стоит денег).
ALLOWED_USER_IDS=

# Часовой пояс по умолчанию
DEFAULT_TZ=Europe/Moscow

# Пути к данным
DB_PATH=data/bot.db
TIMETABLE_PATH=data/timetable.yaml

# Прокси до Telegram, если бот запущен там, где Telegram заблокирован (например, в Китае).
# Пример: http://127.0.0.1:7890  или  socks5://127.0.0.1:1080 (для socks5: pip install aiohttp-socks)
TELEGRAM_PROXY=

# Распознавание голосовых (нужен pip install -r requirements-voice.txt): tiny / base / small
WHISPER_MODEL=base
